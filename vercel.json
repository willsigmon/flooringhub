{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt|.well-known/mcp.json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/oauth/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/services/hardwood",
      "destination": "/hardwood-flooring.html"
    },
    {
      "source": "/services/lvp",
      "destination": "/lvp-flooring.html"
    },
    {
      "source": "/services/refinishing",
      "destination": "/hardwood-refinishing.html"
    },
    {
      "source": "/services/laminate",
      "destination": "/laminate-flooring.html"
    },
    {
      "source": "/services/carpet",
      "destination": "/carpet-installation.html"
    }
  ],
  "redirects": [
    {
      "source": "/services.html",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/hardwood-flooring.html",
      "destination": "/services/hardwood",
      "permanent": true
    },
    {
      "source": "/lvp-flooring.html",
      "destination": "/services/lvp",
      "permanent": true
    },
    {
      "source": "/hardwood-refinishing.html",
      "destination": "/services/refinishing",
      "permanent": true
    },
    {
      "source": "/laminate-flooring.html",
      "destination": "/services/laminate",
      "permanent": true
    },
    {
      "source": "/carpet-installation.html",
      "destination": "/services/carpet",
      "permanent": true
    }
  ]
}
