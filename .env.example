# Optional existing Resend email delivery. Recipient is fixed in api/lead.js
# to Tom's verified tsmith@flooringhubnc.com; otherwise existing FormSubmit
# email delivery is used. Provider activation/sender setup is separate work.
RESEND_API_KEY=
LEAD_FROM_EMAIL=
RESEND_FROM_EMAIL=

# Legacy LEAD_WEBHOOK_URL, JOBBER_WEBHOOK_URL, LEAD_TO_EMAIL, ADMIN_EMAIL
# and FORMSUBMIT_ENDPOINT do not control /api/lead delivery.

# Jobber OAuth (admin/jobber.html). Tokens are stored in KV.
# Once connected, /api/lead copies each emailed lead into Jobber as a
# Client + Request. Optional JOBBER_GRAPHQL_VERSION pins the API version.
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_STATE_SECRET=
JOBBER_REDIRECT_URI=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV's own default var names, read as a fallback by lib/jobber-tokens.js
# if the UPSTASH_REDIS_REST_* pair above isn't set. Same Upstash-backed store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
