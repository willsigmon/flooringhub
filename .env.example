# Primary delivery target for new website leads.
# Use your Zapier / Make / Jobber bridge / CRM webhook URL here.
LEAD_WEBHOOK_URL=

# Optional alias if you want to keep the naming Jobber-specific.
# This is a webhook URL, not proof that Jobber Requests are created.
JOBBER_WEBHOOK_URL=

# Optional email fallback if the webhook is unavailable.
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_TO_EMAIL=

# Fallbacks read by api/lead.js if the pair above isn't set. LEAD_FROM_EMAIL /
# LEAD_TO_EMAIL win when both are present.
RESEND_FROM_EMAIL=
ADMIN_EMAIL=

# Optional no-secret fallback endpoint.
# Defaults to https://formsubmit.co/ajax/<LEAD_TO_EMAIL>
FORMSUBMIT_ENDPOINT=

# Jobber OAuth (admin/jobber.html). Tokens are stored in KV.
# /api/lead does not yet create Jobber Requests from these.
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_STATE_SECRET=
JOBBER_REDIRECT_URI=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV's own default var names, read as a fallback by lib/jobber-tokens.js
# if the UPSTASH_REDIS_REST_* pair above isn't set. Same Upstash-backed store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
